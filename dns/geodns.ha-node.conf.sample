; Run one geodns process per host for DNS, sync, and controller election.
; Put this file in the node's -config directory with no hand-managed zone JSON.
; Change only id and listen when adding another node. Share token and etcd settings.

[dns]
detailedmetrics = true

[sync]
mode = ha
id = pop-1
token = replace-with-the-same-long-random-secret

[controller]
; Optional master priority. Higher wins and reclaims leadership on recovery.
; Equal weights (default 0) keep the current master. Changes require restart.
; weight = 300
listen = 10.80.0.11:8053
; Optional when the externally reachable address differs from listen:
; advertise = https://pop-1.example.net
etcd-endpoints = http://10.80.0.11:2379,http://10.80.0.12:2379,http://10.80.0.13:2379
etcd-prefix = /geodns/production
; On one editing node, set this directory and put your zone JSON there before startup.
; Startup imports it only when etcd has no zones yet. Later edits publish automatically.
; zone-directory = source-zones
; Optional authenticated etcd connection:
; etcd-user = geodns
; etcd-password-file = /etc/geodns/etcd-password
; etcd-ca = /etc/geodns/etcd-ca.pem
; etcd-cert = /etc/geodns/etcd-client.pem
; etcd-key = /etc/geodns/etcd-client-key.pem
